# Salin menjadi .env lalu isi. Jangan commit .env.
# Port gateway di host. Di STB pakai 80. Di laptop pakai 8080 supaya tidak bentrok.
GATEWAY_PORT=8080

# Kunci penandatangan JWT, string acak minimal 32 karakter.
# Di STB, bash deploy.sh mengisinya otomatis. Di laptop: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK

# API key untuk kelompok lain, format nama:kunci dipisah koma. Kunci minimal 16 karakter.
# Contoh: API_KEYS=ahay:isi-kunci-acak-1,aisyahjeko:isi-kunci-acak-2
API_KEYS=
